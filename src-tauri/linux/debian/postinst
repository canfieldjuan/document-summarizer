#!/bin/sh
set -eu

if [ "${1:-}" = "configure" ]; then
  if [ -f /var/lib/document-summarizer/package-quiesce-v1.record ]; then
    /usr/bin/document-summarizer --connect-package adopt-bootstrap
  fi
  /usr/bin/document-summarizer --connect-package initialize
  if [ -f /var/lib/document-summarizer/package-operation-v1.json ]; then
    /usr/bin/document-summarizer --connect-package recover-install "0.1.0"
  fi
fi
