#!/bin/sh
set -eu

case "${1:-}" in
  remove)
    [ -f /var/lib/document-summarizer/package-operation-v1.json ] || exit 0
    action=finish-remove
    ;;
  purge)
    [ ! -L /var/lib/document-summarizer ] || exit 1
    [ -e /var/lib/document-summarizer ] || exit 0
    action=finish-purge
    ;;
  *) exit 0 ;;
esac
[ -n "$(find /var/lib/document-summarizer -maxdepth 0 -type d -perm 0755 -user root -print)" ] || exit 1
controllers=$(find /var/lib/document-summarizer -maxdepth 1 -type f -name 'package-controller-*' -perm 0700 -user root -links 1 -print)
set -- $controllers
if [ "$#" -eq 0 ] && [ "$action" = finish-purge ]; then
  # A completed purge retains only its stable locks and empty participant directory.
  remaining=$(find /var/lib/document-summarizer -mindepth 1 ! \( \
    \( -path /var/lib/document-summarizer/participants-v1 -type d -perm 1777 -user root \) -o \
    \( -path /var/lib/document-summarizer/.package-controller-v1.lock -type f -perm 0600 -user root -links 1 \) -o \
    \( \( -path /var/lib/document-summarizer/.package-operation-v1.lock -o -path /var/lib/document-summarizer/.package-quiesce-v1.lock \) -type f -perm 0644 -user root -links 1 \) \) -print)
  [ -z "$remaining" ]
  exit
fi
[ "$#" -eq 1 ] || exit 1
"$1" --connect-package "$action" "0.1.0"
